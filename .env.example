# Biến cho docker-compose.yml (production). Chép thành .env ở thư mục gốc repo rồi sửa:
#   cp .env.example .env && chmod 600 .env
# Mỗi dòng dạng KHOA=gia_tri, không khoảng trắng quanh dấu =, không dấu nháy.

# Tên miền đã trỏ về IP server (Caddy tự lấy HTTPS cho tên miền này).
SITE_ADDRESS=ten-mien-cua-ban.vn
# Địa chỉ người dùng mở trên trình duyệt: https:// + tên miền, không có / ở cuối.
PUBLIC_URL=https://ten-mien-cua-ban.vn

# Mật khẩu database. Sinh bằng: openssl rand -hex 24   (chỉ chữ và số, dán thẳng vào URL được)
POSTGRES_PASSWORD=

# Múi giờ tính "hôm nay", "tuần", streak
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Chưa có tên miền, chạy thử bằng IP qua HTTP (KHÔNG dùng thật: mật khẩu đi qua mạng không mã hóa):
#   SITE_ADDRESS=:80
#   PUBLIC_URL=http://<IP-server>
#   COOKIE_SECURE=false
#   NODE_ENV=development

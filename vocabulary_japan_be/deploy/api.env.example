# Biến môi trường production của API. Chép ra /etc/jpvocab/api.env:
#   sudo install -o jpvocab -g jpvocab -m 600 deploy/api.env.example /etc/jpvocab/api.env
# rồi sửa giá trị. File này được systemd (EnvironmentFile) và deploy.sh (source) đọc:
# mỗi dòng dạng KHOA=gia_tri, không có khoảng trắng quanh dấu =, không dùng dấu nháy.
NODE_ENV=production
PORT=4000
HOST=127.0.0.1
DATABASE_URL=postgresql://jpvocab:DOI_MAT_KHAU_MANH@localhost:5432/jpvocab
CORS_ORIGIN=https://ten-mien-cua-ban.vn
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
SESSION_TTL_DAYS=30
APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=info
TRUST_PROXY=loopback

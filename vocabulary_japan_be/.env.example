# Môi trường: development | test | production
NODE_ENV=development

# Kết nối PostgreSQL (docker compose up -d chạy DB dev ở cổng 5432, DB test ở 5433)
DATABASE_URL=postgresql://jpvocab:jpvocab@localhost:5432/jpvocab
# DB riêng cho test (npm test), không bao giờ trỏ vào DB dev hay production
DATABASE_URL_TEST=postgresql://jpvocab:jpvocab@localhost:5433/jpvocab_test

# Cổng HTTP của API
PORT=4000

# Origin của frontend được phép gọi API (CORS + kiểm tra Origin chống CSRF)
CORS_ORIGIN=http://localhost:5173

# Phiên đăng nhập
SESSION_TTL_DAYS=30
# true khi chạy HTTPS (production)
COOKIE_SECURE=false
# lax khi frontend và API cùng domain (khuyến nghị); none khi khác domain (bắt buộc COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax

# Múi giờ tính "hôm nay", "tuần", streak
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Mức log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

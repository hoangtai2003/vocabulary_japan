# Caddy cho Sổ luyện chữ: một domain phục vụ cả frontend (file tĩnh) và API (/api → container api).
# SITE_ADDRESS lấy từ .env: là tên miền thì Caddy tự lấy và gia hạn chứng chỉ Let's Encrypt,
# chuyển HTTP → HTTPS; là ":80" thì chạy HTTP thường (chỉ để thử bằng IP).

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}

{$SITE_ADDRESS} {
	# Body tối đa 6 MB (API tự giới hạn JSON ở 1 MB).
	request_body {
		max_size 6MB
	}

	encode zstd gzip

	# API: Caddy tự gửi X-Forwarded-For / X-Forwarded-Proto, Express (trust proxy) đọc ra IP
	# thật của người dùng (rate limit). Header bảo mật của API do helmet đặt.
	handle /api/* {
		reverse_proxy api:4000
	}

	# File build có hash trong tên: cache dài hạn, không bao giờ đổi nội dung.
	handle /assets/* {
		root * /srv
		import security_headers
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Mọi đường dẫn khác: file tĩnh nếu có, không thì index.html để React Router xử lý
	# (tải lại ở /tu-vung, /quan-tri... không bị 404). Không cache index.html, để bản deploy
	# mới có hiệu lực ngay.
	handle {
		root * /srv
		import security_headers
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
